# MongoDB
MONGO_URL=mongodb+srv://<db_username>:<db_password>@<cluster-url>/<database>?retryWrites=true&w=majority

# Session
SESSION_SECRET=replace_with_a_long_random_secret

# Brevo HTTP API - required for email OTP
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=your_verified_sender@example.com
BREVO_FROM_NAME=Maison Market

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Razorpay test keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary - persistent profile picture storage (required for profile images on Render/multiple devices)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
